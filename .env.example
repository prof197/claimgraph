# Copy to .env and fill in. Only live runs need these; replay mode runs without them.
ANTHROPIC_API_KEY=
# Only the council arms' live runs need these, for their OpenAI and Google members.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: raises the PubMed E-utilities limit from 3 to 10 requests per second.
NCBI_API_KEY=
# Identify the client to NCBI, as its usage guidelines ask.
NCBI_TOOL=claimgraph
NCBI_EMAIL=
# Optional: an absolute path holding runs/ and local-data/, so several checkouts share one copy.
# Unset, they live in the working directory.
CLAIMGRAPH_DATA=
