#!/usr/bin/env bash
# The checks every commit must pass. Enable once per clone: git config core.hooksPath .githooks
# They run on the working tree, so stash unstaged changes first to check exactly what is staged.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# No absolute home path is ever committed: they name the machine's user. The pattern is split
# so this file does not match itself.
home='/Use''rs/'
if git grep --cached -l -F -e "$home"; then
  echo "staged files above contain an absolute home path ($home); make it relative" >&2
  exit 1
fi

uv run ruff format --check .
uv run ruff check .
uv run pyright
uv run pytest -q

# The static page, once it is scaffolded; its package.json defines the check script.
if [ -f site/package.json ]; then
  npm --prefix site run check
fi
