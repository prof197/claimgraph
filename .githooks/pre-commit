#!/usr/bin/env bash
# The checks every commit must pass. Enable once per clone: git config core.hooksPath .githooks
# They run on the working tree, so stash unstaged changes first to check exactly what is staged.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

uv run ruff format --check .
uv run ruff check .
uv run pyright
uv run pytest -q

# The static page, once it exists; its package.json defines the check script.
if [ -d site ]; then
  npm --prefix site run check
fi
